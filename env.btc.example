# ==========================================
# BTCUSD ENVIRONMENT SETTINGS (Exness Broker)
# ==========================================
# Copy this file to .env (or merge into your existing .env)
# when switching from XAUUSD to BTCUSD trading.
#
# BROKER: Exness — BTCUSD contract specs:
#   Contract size: 1 lot = 1 BTC
#   Digits: 2 (e.g. 84521.50), so 1 point = $0.01
#   Min lot: 0.01 (= 0.01 BTC)
#   Typical spread: $15-$40
#   Leverage: varies by account (up to 1:400 for crypto)
#
# KEY DIFFERENCES vs XAUUSD:
# - BTC trades 24/7 (no weekend/daily close hours)
# - POINT_VALUE_PER_LOT = 0.01 (gold is 1.0) because 1 BTC/lot vs 100 oz/lot
# - SL/TP in points are 100x larger (e.g. 30000 points = $300)
# - Trailing floors/breakeven are in USD price units (not points)
# - Friday auto-close is disabled automatically for crypto symbols
# - News keywords switch to crypto-relevant topics automatically
# ==========================================

# ==========================================
# SYMBOL — CRITICAL: must be set correctly
# ==========================================
SYMBOL=BTCUSD

# ==========================================
# DASHBOARD AUTHENTICATION
# ==========================================
# Set a password to protect the Streamlit dashboard.
# Leave empty to disable authentication (open access).
DASHBOARD_PASSWORD=your-secure-password-here
# Optional: custom salt for password hashing (change for extra security)
# DASHBOARD_SALT=my-custom-salt-string

# ==========================================
# AI PROVIDER (same as gold — no change needed)
# ==========================================
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
MODEL=qwen/qwen3.5-122b-a10b
FORECAST_MODEL=google/gemini-2.5-flash-lite

# ==========================================
# THINKING / REASONING MODE
# ==========================================
# Enable thinking mode for AI models that support it (e.g. Qwen 3.5).
# The model will reason in <think>...</think> blocks before giving an answer.
# Produces better trade decisions but uses more tokens and takes longer.
AI_THINKING=true

# ==========================================
# SHARED AI SETTINGS
# ==========================================
MAX_TOKENS=16384
TEMPERATURE=0.6
TOP_P=0.95

# ==========================================
# NODE CONNECTION (WINDOWS VPS)
# ==========================================
WINDOWS_IP=123.45.67.89

# ==========================================
# DATABASE & REDIS (same as gold)
# ==========================================
DB_HOST=db
DB_USER=admin
DB_PASS=secretpassword
DB_NAME=trading_log
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# NEWS (Finnhub)
# ==========================================
FINNHUB_API_KEY=your-finnhub-api-key-here

# ==========================================
# RISK MANAGEMENT — BTC-SPECIFIC (Exness)
# ==========================================
ACCOUNT_BALANCE=100.00

# Risk per trade: 0.5% conservative
# ⚠️ WARNING for small accounts: Exness min lot = 0.01 BTC (~$850 at $85k).
# With a $100 account, even the minimum lot often exceeds the target risk %.
# The bot will use 0.01 lot (minimum) regardless of calculated risk.
# Consider: increasing account balance, or using a broker with smaller BTC contracts.
RISK_PERCENT=0.5

# POINT_VALUE_PER_LOT — Exness BTCUSD contract:
#   Contract size = 1 BTC per 1 standard lot
#   BTCUSD quoted with 2 decimal places (e.g. 84521.50)
#   1 point = $0.01 price move
#   1 point × 1 lot (1 BTC) = $0.01 profit/loss
#   So POINT_VALUE_PER_LOT = 0.01
POINT_VALUE_PER_LOT=0.01

# Point size: Exness BTCUSD uses 2 decimal places → 0.01
# (same as gold, but verify with your account)
POINT_SIZE=0.01

# Fixed SL/TP fallback — in POINTS (1 point = $0.01 on Exness BTC)
# For $250 SL in USD: $250 / $0.01 = 25,000 points
SL_POINTS=25000
TP_POINTS=40000

# Dynamic SL/TP (ATR-based) — ATR auto-calculates from candles
# These clamps are in POINTS (multiply USD by 100 for Exness BTC 2-digit)
ATR_SL_MULTIPLIER=1.0
ATR_TP_MULTIPLIER=1.5
MIN_SL_POINTS=15000           # $150 minimum SL
MAX_SL_POINTS=50000           # $500 maximum SL
MIN_TP_POINTS=20000           # $200 minimum TP
MAX_TP_POINTS=80000           # $800 maximum TP

# Confidence — keep strict
MIN_CONFIDENCE=7

# Max spread — Exness BTCUSD typical spread: $15-$40 depending on session
MAX_SPREAD=30

# Trade cooldown (seconds)
MIN_TRADE_INTERVAL_SEC=120

# Max drawdown % — same percentage-based rule
MAX_DRAWDOWN_PCT=10

# Daily loss limit in USD
DAILY_LOSS_LIMIT=15

# Market closed check (BTC is 24/7, but keep for safety)
MARKET_CLOSED_CHECK_SEC=300

# Friday auto-close — automatically SKIPPED for crypto symbols
# (code detects BTC prefix and disables weekend gap protection)
FRIDAY_AUTO_CLOSE=false

# ==========================================
# SMART POSITION MANAGER — BTC-SPECIFIC
# ==========================================
POSITION_CHECK_INTERVAL=5
MIN_HOLD_SEC=120
MAX_HOLD_SEC=1800
MAX_HOLD_SEC_LOSS=900         # Crypto: 15 min (higher volatility = wider oscillation)
TRAILING_STEP_PRICE=50        # BTC: $50 trailing step (gold was $0.50)
TRAILING_PROTECT_PCT=60
PROFIT_LOCK_PCT=3.0
BREAKEVEN_TRIGGER_PCT=0.2
MIN_PROFIT_CLOSE_PCT=0.5
AI_FORECAST_COOLDOWN=20

# ---- 3-Phase Adaptive Trailing Stop ----
# ATR multipliers stay the same — ATR adapts to BTC volatility
TRAIL_PHASE1_ATR=0.50
TRAIL_PHASE2_ATR=0.75
TRAIL_PHASE3_ATR=1.00

# Floor values for trailing gaps — BTC-specific (gold was $0.50/$0.80/$1.20)
# BTC H1 ATR is typically $300-800, so floors should be ~$50-$150
TRAIL_FLOOR_P1=50             # Min $50 gap (gold: $0.50)
TRAIL_FLOOR_P2=80             # Min $80 gap (gold: $0.80)
TRAIL_FLOOR_P3=120            # Min $120 gap (gold: $1.20)

# Breakeven distance — BTC needs $50+ move before breakeven trigger (gold: $1.00)
BREAKEVEN_DISTANCE=50

# Breakeven offset — min/max for ATR-based offset calculation
BE_OFFSET_MIN=10              # BTC: min $10 offset (gold: $0.10)
BE_OFFSET_MAX=50              # BTC: max $50 offset (gold: $0.50)

PARTIAL_CLOSE_PCT=0.5
SPIKE_THRESHOLD=200           # BTC: $200 spike detection (gold: $2.00)
MAX_CONCURRENT_POS=1
MAX_LOT=0.01                  # BTC: 0.01 lot = 0.01 BTC (~$800-1000)

# ==========================================
# SAFETY & FILTERS
# ==========================================
# BTC has no "bad hours" per se, but Asian session (01:00-06:00 UTC) has lower volume
BAD_HOURS_UTC=2,3

LOSS_PAUSE_THRESHOLD=3
LOSS_PAUSE_SEC=1800
RECOVERY_COOLDOWN_SEC=60

# ==========================================
# SCALP TIMEFRAME
# ==========================================
SCALP_TIMEFRAME=M5
