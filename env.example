# ==========================================
# DASHBOARD AUTHENTICATION
# ==========================================
# Set a password to protect the Streamlit dashboard.
# Leave empty to disable authentication (open access).
DASHBOARD_PASSWORD=your-secure-password-here
# Optional: custom salt for password hashing (change for extra security)
# DASHBOARD_SALT=my-custom-salt-string

# ==========================================
# AI PROVIDER SELECTION
# ==========================================
# Choose primary provider: "openrouter" or "nvidia"
AI_PROVIDER=openrouter

# ==========================================
# OPENROUTER AI SETTINGS (Main Analysis)
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Main model — used for BUY/SELL/WAIT decisions (smart, thorough)
MODEL=deepseek/deepseek-v3.2
# Alternative: Qwen 3.5 with thinking mode:
# MODEL=qwen/qwen3.5-122b-a10b

# ==========================================
# FORECAST MODEL (Quick Position Checks)
# ==========================================
# Separate model for rapid HOLD/CLOSE forecasts (every 20s per position)
# Should be fast & cheap. Uses same OPENROUTER_API_KEY.
# Leave empty to use the main MODEL for both.
FORECAST_MODEL=google/gemini-2.5-flash-lite

# ==========================================
# THINKING / REASONING MODE
# ==========================================
# Enable thinking mode for AI models that support it (e.g. Qwen 3.5).
# The model will reason in <think>...</think> blocks before answering.
# Produces better trade decisions but uses more tokens and takes longer.
# Only applies to main analysis — forecast stays fast without thinking.
AI_THINKING=false

# ==========================================
# NVIDIA AI SETTINGS (Alternative Provider)
# ==========================================
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ==========================================
# SHARED AI SETTINGS
# ==========================================
MAX_TOKENS=400
TEMPERATURE=0.1

# ==========================================
# NODE CONNECTION (WINDOWS VPS)
# ==========================================
WINDOWS_IP=123.45.67.89
SYMBOL=XAUUSD

# ==========================================
# DATABASE SETTINGS (POSTGRESQL)
# ==========================================
DB_HOST=db
DB_USER=admin
DB_PASS=secretpassword
DB_NAME=trading_log

# ==========================================
# REDIS SETTINGS (Market Journal & Cache)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# NEWS & MACRO EVENTS (Finnhub - free tier)
# ==========================================
# Sign up free at https://finnhub.io/ to get API key
FINNHUB_API_KEY=your-finnhub-api-key-here

# ==========================================
# RISK MANAGEMENT SETTINGS
# ==========================================
# ACCOUNT_BALANCE is fallback only (bot reads live balance from MT5)
ACCOUNT_BALANCE=100.00

# Risk per trade: 0.5% = conservative for real money
# $1000 x 0.5% = $5 risk per trade -> lot ~0.01-0.02
RISK_PERCENT=0.5

# Fixed SL/TP fallback (used only when ATR data unavailable)
SL_POINTS=200
TP_POINTS=400

# Dynamic SL/TP (ATR-based) - preferred over fixed
# PROFIT-FOCUSED: TP must be ACHIEVABLE (1.5x-2.5x SL, not 4-5x)
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=2.0
MIN_SL_POINTS=150
MAX_SL_POINTS=400
MIN_TP_POINTS=250             # NEW: Min TP floor for reachable targets
MAX_TP_POINTS=500             # Cap TP — must be achievable in scalp timeframe

# Min AI confidence to execute trade (1-10)
# Higher = fewer trades but higher quality signals
# CRITICAL: Set to 7 to prevent over-trading (was 5, caused 52 trades/day)
MIN_CONFIDENCE=7

# Max spread allowed - real accounts have tighter spreads
# Reject entry if spread > $0.50 (50 cents)
MAX_SPREAD=0.50

# NEW: Minimum seconds between trades (prevents rapid-fire over-trading)
MIN_TRADE_INTERVAL_SEC=120

# Point value per standard lot (XAUUSD: $1 per 1-point per lot)
POINT_VALUE_PER_LOT=1.0

# Point size: minimum price increment for the instrument
# XAUUSD on Exness: 2 decimal places → 0.01
POINT_SIZE=0.01

# Max drawdown % from peak balance — auto-stops bot when exceeded
MAX_DRAWDOWN_PCT=10

# Daily loss limit in USD — stops ALL trading for the day when exceeded
# Set to 0 to disable. Resets at midnight UTC.
DAILY_LOSS_LIMIT=10

# Market closed check interval (seconds)
MARKET_CLOSED_CHECK_SEC=300

# ---- Friday Auto-Close (Weekend Gap Protection) ----
# Automatically close ALL positions before the Friday market close
# to avoid weekend gap risk. XAUUSD market closes Friday 22:00 UTC.
FRIDAY_AUTO_CLOSE=true
# How many minutes before Friday close to start closing positions
# e.g. 30 = close all at 21:30 UTC (30 min before 22:00)
FRIDAY_CLOSE_MINUTES_BEFORE=30
# Block new trades this many minutes before Friday close
# Should be >= FRIDAY_CLOSE_MINUTES_BEFORE
FRIDAY_NO_NEW_TRADE_MINUTES=60

# ==========================================
# SMART POSITION MANAGER
# ==========================================
POSITION_CHECK_INTERVAL=5     # Check positions every 5 seconds (faster detection)
MIN_HOLD_SEC=120              # Min hold 2 min before smart-close (was 60s — too aggressive)
MAX_HOLD_SEC=1800             # Let winners run up to 30 min
MAX_HOLD_SEC_LOSS=600         # Losing positions: cut faster (10 min max)
TRAILING_STEP_PRICE=0.50      # Trailing stop gap ($0.50 gold price)
TRAILING_PROTECT_PCT=60       # Lock 60% of profit distance (tighter protection)
PROFIT_LOCK_PCT=3.0           # Auto-close at 3% of balance ($30 on $1000)
BREAKEVEN_TRIGGER_PCT=0.2     # Move SL to breakeven at 0.2% of balance ($2 on $1000)
MIN_PROFIT_CLOSE_PCT=0.5      # Min profit 0.5% of balance ($5) to trigger AI close check
AI_FORECAST_COOLDOWN=20       # Rate limit AI forecast calls (seconds per position)

# ---- 3-Phase Adaptive Trailing Stop ----
# WIDER GAPS = let winners run to meaningful profit ($2-$5)
# Phase 1 (small profit): protect entry but give room to breathe
TRAIL_PHASE1_ATR=0.50         # ATR × 0.50 = ~$1.50 gap (e.g. ATR=$3)
# Phase 2 (good profit >= MIN_PROFIT_CLOSE): let trade develop fully
TRAIL_PHASE2_ATR=0.75         # ATR × 0.75 = ~$2.25 gap
# Phase 3 (after partial close, 50% already banked): widest, runner
TRAIL_PHASE3_ATR=1.00         # ATR × 1.00 = ~$3.00 gap
# Breakeven trigger: price must move this many USD before SL moves to entry
# CRITICAL: Was $0.50 which triggered too early. $1.00 gives room for normal retracement
BREAKEVEN_DISTANCE=1.00       # $1.00 distance (was $0.50)

# Partial close — close 50% of position at this profit threshold (% of balance)
PARTIAL_CLOSE_PCT=0.5

# NEW: Rapid price spike detection — close immediately if price moves this much (USD) in one check
SPIKE_THRESHOLD=2.0

# NEW: Max concurrent positions — set to 1 for single-trade safety, 2+ for hedging/scaling
MAX_CONCURRENT_POS=1

# NEW: Max lot size clamp — prevents over-sized positions regardless of risk calc
MAX_LOT=0.10

# ==========================================
# SAFETY & FILTERS
# ==========================================
# Bad hours (UTC) to skip trading - comma separated
# 02:00-06:00 UTC showed worst P/L in trade analysis
BAD_HOURS_UTC=2,3,4,5,6

# Consecutive loss pause: pause trading after N consecutive losses
LOSS_PAUSE_THRESHOLD=3        # Pause after 3 consecutive losses
LOSS_PAUSE_SEC=1800           # Pause for 30 minutes (if recovery trade is declined)

# NEW: Recovery trade cooldown — wait this many seconds before attempting recovery
RECOVERY_COOLDOWN_SEC=60

# ==========================================
# SCALP TIMEFRAME (default M5, can use M1 for ultra-fast)
# ==========================================
SCALP_TIMEFRAME=M5

# ==========================================
# BOT LOOP SETTINGS (defaults - adjustable from Dashboard)
# ==========================================
# BOT_INTERVAL=300          # Seconds (overridden by DB bot_settings)
# CONSECUTIVE_ERR_LIMIT=5   # Auto-stop after N consecutive errors