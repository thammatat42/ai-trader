# ==========================================
# AI PROVIDER SELECTION
# ==========================================
# เลือก provider: "openrouter" หรือ "nvidia"
AI_PROVIDER=openrouter

# ==========================================
# OPENROUTER AI SETTINGS
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
MODEL=anthropic/claude-3-haiku

# ==========================================
# NVIDIA AI SETTINGS (build.nvidia.com)
# ==========================================
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ==========================================
# SHARED AI SETTINGS
# ==========================================
MAX_TOKENS=400
TEMPERATURE=0.1

# ==========================================
# NODE CONNECTION (WINDOWS VPS)
# ==========================================
WINDOWS_IP=123.45.67.89
SYMBOL=XAUUSD

# ==========================================
# DATABASE SETTINGS (POSTGRESQL)
# ==========================================
DB_HOST=db
DB_USER=admin
DB_PASS=secretpassword
DB_NAME=trading_log

# ==========================================
# REDIS SETTINGS (Market Journal & Cache)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# NEWS & MACRO EVENTS (Finnhub – free tier)
# ==========================================
# สมัครฟรีที่ https://finnhub.io/ → ได้ API key
FINNHUB_API_KEY=your-finnhub-api-key-here

# ==========================================
# RISK MANAGEMENT SETTINGS
# ==========================================
ACCOUNT_BALANCE=1000.00
RISK_PERCENT=1.0
SL_POINTS=300
TP_POINTS=600

# Dynamic SL/TP (ATR-based) – ใช้แทน fixed SL/TP เมื่อมี candle data
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=2.5
MIN_SL_POINTS=100
MAX_SL_POINTS=500

# Min AI confidence to execute trade (1-10)
MIN_CONFIDENCE=5

# Max spread allowed (ข้ามเมื่อ spread > ค่านี้)
MAX_SPREAD=5.0

# ==========================================
# SMART POSITION MANAGER
# ==========================================
POSITION_CHECK_INTERVAL=10    # เช็ค positions ทุก N วินาที
MIN_HOLD_SEC=180              # เวลาขั้นต่ำก่อน smart-close (3 นาที)
MAX_HOLD_SEC=600              # เวลาสูงสุด → force close ถ้ากำไร (10 นาที)
MIN_PROFIT_TO_CLOSE=0.50      # กำไรขั้นต่ำ ($) เพื่อ trigger smart-close
BREAKEVEN_PROFIT_USD=1.00     # ย้าย SL เป็น breakeven เมื่อกำไร $1+
TRAILING_STEP_PRICE=1.0       # Trailing stop step ($1 ราคาทอง)
AI_FORECAST_COOLDOWN=30       # Rate limit AI forecast calls (seconds per position)

# ==========================================
# BOT LOOP SETTINGS (ค่าเริ่มต้น – ปรับได้จาก Dashboard)
# ==========================================
# BOT_INTERVAL=300          # วินาที (ถูก override โดย DB bot_settings)
# CONSECUTIVE_ERR_LIMIT=5   # หยุดอัตโนมัติหลังผิดพลาดติดต่อกัน N ครั้ง