# ==========================================
# AI PROVIDER SELECTION
# ==========================================
# Choose provider: "openrouter" or "nvidia"
AI_PROVIDER=openrouter

# ==========================================
# OPENROUTER AI SETTINGS
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
MODEL=anthropic/claude-3-haiku

# ==========================================
# NVIDIA AI SETTINGS (build.nvidia.com)
# ==========================================
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ==========================================
# SHARED AI SETTINGS
# ==========================================
MAX_TOKENS=400
TEMPERATURE=0.1

# ==========================================
# NODE CONNECTION (WINDOWS VPS)
# ==========================================
WINDOWS_IP=123.45.67.89
SYMBOL=XAUUSD

# ==========================================
# DATABASE SETTINGS (POSTGRESQL)
# ==========================================
DB_HOST=db
DB_USER=admin
DB_PASS=secretpassword
DB_NAME=trading_log

# ==========================================
# REDIS SETTINGS (Market Journal & Cache)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# NEWS & MACRO EVENTS (Finnhub - free tier)
# ==========================================
# Sign up free at https://finnhub.io/ to get API key
FINNHUB_API_KEY=your-finnhub-api-key-here

# ==========================================
# RISK MANAGEMENT SETTINGS
# ==========================================
# ACCOUNT_BALANCE is fallback only (bot reads live balance from MT5)
ACCOUNT_BALANCE=1000.00

# Risk per trade: 0.5% = conservative for real money
# $1000 x 0.5% = $5 risk per trade -> lot ~0.01-0.02
RISK_PERCENT=0.5

# Fixed SL/TP fallback (used only when ATR data unavailable)
SL_POINTS=200
TP_POINTS=400

# Dynamic SL/TP (ATR-based) - preferred over fixed
# Lower multipliers = tighter stops = less risk per trade
ATR_SL_MULTIPLIER=1.2
ATR_TP_MULTIPLIER=2.0
MIN_SL_POINTS=100
MAX_SL_POINTS=350
MAX_TP_POINTS=600            # Cap TP for scalps ($6 max distance)

# Min AI confidence to execute trade (1-10)
# Higher = fewer trades but higher quality signals
MIN_CONFIDENCE=6

# Max spread allowed - real accounts have tighter spreads
# Reject entry if spread > $0.50 (50 cents)
MAX_SPREAD=0.50

# ==========================================
# SMART POSITION MANAGER
# ==========================================
POSITION_CHECK_INTERVAL=10    # Check positions every 10 seconds
MIN_HOLD_SEC=60               # Min hold 1 min before smart-close (scalp-friendly)
MAX_HOLD_SEC=1800             # Let winners run up to 30 min
TRAILING_STEP_PRICE=0.50      # Trailing stop gap ($0.50 gold price)
TRAILING_PROTECT_PCT=60       # Lock 60% of profit distance (tighter protection)
PROFIT_LOCK_PCT=3.0           # Auto-close at 3% of balance ($30 on $1000)
BREAKEVEN_TRIGGER_PCT=0.2     # Move SL to breakeven at 0.2% of balance ($2 on $1000)
MIN_PROFIT_CLOSE_PCT=0.3      # Min profit 0.3% of balance ($3) to trigger AI close check
AI_FORECAST_COOLDOWN=30       # Rate limit AI forecast calls (seconds per position)

# ==========================================
# SAFETY & FILTERS
# ==========================================
# Bad hours (UTC) to skip trading - comma separated
# 02:00-06:00 UTC showed worst P/L in trade analysis
BAD_HOURS_UTC=2,3,4,5,6

# Consecutive loss pause: pause trading after N consecutive losses
LOSS_PAUSE_THRESHOLD=3        # Pause after 3 consecutive losses
LOSS_PAUSE_SEC=1800           # Pause for 30 minutes

# ==========================================
# BOT LOOP SETTINGS (defaults - adjustable from Dashboard)
# ==========================================
# BOT_INTERVAL=300          # Seconds (overridden by DB bot_settings)
# CONSECUTIVE_ERR_LIMIT=5   # Auto-stop after N consecutive errors